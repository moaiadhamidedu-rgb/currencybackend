{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "currency-tracker-backend",
	"main": "src/cloudflare/worker.ts",
	"compatibility_date": "2026-08-27",
	"workers_dev": true,
	"observability": {
		"enabled": true,
	},
	"triggers": {
		"crons": [
			"*/30 * * * *"
		],
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "currency-tracker-db",
			"database_id": "5952260c-2622-4d3f-9013-bc87b7ebc224"
		}
	],
	// The D1 binding is added automatically by:
	// npm run cf:d1:create
}