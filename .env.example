DATABASE_URL="file:./dev.db"
PORT=3000

# AI extraction provider: gemini or deepseek.
AI_PROVIDER=gemini

# Gemini API (Google AI Studio free tier can be used within its limits).
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=4096

# Optional DeepSeek fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_MAX_TOKENS=500

# Collection and deterministic validation settings.
COLLECTION_INTERVAL_MS=1800000
COLLECT_ON_STARTUP=false
SOURCE_FETCH_TIMEOUT_MS=15000
OBSERVATION_MAX_AGE_MINUTES=90
OUTLIER_THRESHOLD_PERCENT=3
SOURCE_CONTENT_MAX_CHARS=50000
